--- !u!114 &4070493392891866658
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9023186730451973026}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8afd5ad23f007a147a114dbd6b3086a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Sandbox.CharacterSystem::Sandbox.CharacterSystem.ExpressionModule
  face: {fileID: 8593031941644686879}
  lipSync: {fileID: 5485729948830511593}
  blendShapeDriver: {fileID: 1318664054334424218}
  blendShapeDebugger: {fileID: 0}
  intensity: 1
  neutralFadeDuration: 0.18
  endOfSpeechDelay: 0.15
  speechGaze:
    enabled: 1
    target: {fileID: 0}
    head: {fileID: 8795013200340876773}
    blendDuration: 0.15
    horizontalEyeRange: 30
    verticalEyeRange: 20
    assistHead: 0
    maximumHeadCorrection: 20
  facialMotions:
  - name: Blink
    enabled: 1
    channel: Blink
    idleOnly: 0
    interval: {x: 2, y: 6}
    easeIn: 0.06
    hold: {x: 0.03, y: 0.03}
    easeOut: 0.12
    variants:
    - name: Both eyes
      pose:
        targets:
        - shape: eyeBlinkLeft
          weight: 100
        - shape: eyeBlinkRight
          weight: 100
      strength: {x: 1, y: 1}
    repeat:
      probability: 0.15
      maximumAdditionalRepetitions: 1
      gap: {x: 0.12, y: 0.25}
  - name: Lip purse
    enabled: 1
    channel: Mouth
    idleOnly: 1
    interval: {x: 8, y: 16}
    easeIn: 0.25
    hold: {x: 0.5, y: 1.5}
    easeOut: 0.35
    variants:
    - name: Purse
      pose:
        targets:
        - shape: mouthPressLeft
          weight: 75
        - shape: mouthPressRight
          weight: 75
      strength: {x: 2, y: 2}
    repeat:
      probability: 0
      maximumAdditionalRepetitions: 1
      gap: {x: 0.12, y: 0.25}
  - name: Lip twitch
    enabled: 1
    channel: Mouth
    idleOnly: 1
    interval: {x: 3, y: 7}
    easeIn: 0.12
    hold: {x: 0.12, y: 0.12}
    easeOut: 0.12
    variants:
    - name: Left
      pose:
        targets:
        - shape: mouthLeft
          weight: 50
      strength: {x: 0.5, y: 2}
    - name: Right
      pose:
        targets:
        - shape: mouthRight
          weight: 50
      strength: {x: 0.5, y: 2}
    repeat:
      probability: 0
      maximumAdditionalRepetitions: 1
      gap: {x: 0.12, y: 0.25}
  - name: Gaze
    enabled: 1
    channel: Gaze
    idleOnly: 1
    interval: {x: 4, y: 9}
    easeIn: 0.18
    hold: {x: 0.8, y: 1.8}
    easeOut: 0.25
    variants:
    - name: Character left
      pose:
        targets:
        - shape: eyeLookOutLeft
          weight: 25
        - shape: eyeLookInRight
          weight: 25
      strength: {x: 0.6, y: 1}
    - name: Character right
      pose:
        targets:
        - shape: eyeLookInLeft
          weight: 25
        - shape: eyeLookOutRight
          weight: 25
      strength: {x: 0.6, y: 1}
    - name: Up
      pose:
        targets:
        - shape: eyeLookUpLeft
          weight: 25
        - shape: eyeLookUpRight
          weight: 25
      strength: {x: 0.6, y: 1}
    - name: Down
      pose:
        targets:
        - shape: eyeLookDownLeft
          weight: 25
        - shape: eyeLookDownRight
          weight: 25
      strength: {x: 0.6, y: 1}
    repeat:
      probability: 0
      maximumAdditionalRepetitions: 1
      gap: {x: 0.12, y: 0.25}
  - name: Pucker
    enabled: 1
    channel: Mouth
    idleOnly: 1
    interval: {x: 8, y: 16}
    easeIn: 0.25
    hold: {x: 0.25, y: 0.5}
    easeOut: 0.35
    variants:
    - name: Pucker
      pose:
        targets:
        - shape: mouthPucker
          weight: 50
      strength: {x: 2, y: 2}
    repeat:
      probability: 0
      maximumAdditionalRepetitions: 1
      gap: {x: 0.12, y: 0.25}
  previewDefinition: {fileID: 11400000, guid: 60eabea092f840d4e96d822264be2b1d, type: 2}
