--- !u!114 &3732106779167652950
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 8195936407956639848}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8afd5ad23f007a147a114dbd6b3086a4, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Sandbox.CharacterSystem::Sandbox.CharacterSystem.ExpressionModule
  face: {fileID: 3894063114924010226}
  lipSync: {fileID: 59960727371503789}
  blendShapeDriver: {fileID: 4500903134185045895}
  blendShapeDebugger: {fileID: 4371608934142311445}
  intensity: 1
  neutralFadeDuration: 0.18
  endOfSpeechDelay: 0.3
  facialMotions:
  - name: Blink
    enabled: 1
    channel: Blink
    idleOnly: 0
    interval: {x: 2, y: 6}
    easeIn: 0.06
    hold: {x: 0.03, y: 0.03}
    easeOut: 0.12
    variants:
    - name: Both eyes
      pose:
        targets:
        - shape: eyeBlinkLeft
          weight: 100
        - shape: eyeBlinkRight
          weight: 100
      strength: {x: 1, y: 1}
    repeat:
      probability: 0.15
      maximumAdditionalRepetitions: 1
      gap: {x: 0.12, y: 0.25}
  - name: Lip purse
    enabled: 1
    channel: Mouth
    idleOnly: 1
    interval: {x: 8, y: 16}
    easeIn: 0.25
    hold: {x: 0.25, y: 0.5}
    easeOut: 0.35
    variants:
    - name: Purse
      pose:
        targets:
        - shape: mouthPucker
          weight: 15
        - shape: mouthPressLeft
          weight: 5
        - shape: mouthPressRight
          weight: 5
      strength: {x: 1, y: 1}
    repeat:
      probability: 0
      maximumAdditionalRepetitions: 1
      gap: {x: 0.12, y: 0.25}
  - name: Lip twitch
    enabled: 1
    channel: Mouth
    idleOnly: 1
    interval: {x: 8, y: 16}
    easeIn: 0.06
    hold: {x: 0.03, y: 0.03}
    easeOut: 0.12
    variants:
    - name: Left
      pose:
        targets:
        - shape: mouthLeft
          weight: 10
      strength: {x: 0.5, y: 1}
    - name: Right
      pose:
        targets:
        - shape: mouthRight
          weight: 10
      strength: {x: 0.5, y: 1}
    repeat:
      probability: 0
      maximumAdditionalRepetitions: 1
      gap: {x: 0.12, y: 0.25}
  - name: Gaze
    enabled: 1
    channel: Gaze
    idleOnly: 1
    interval: {x: 4, y: 9}
    easeIn: 0.18
    hold: {x: 0.8, y: 1.8}
    easeOut: 0.25
    variants:
    - name: Character left
      pose:
        targets:
        - shape: eyeLookOutLeft
          weight: 25
        - shape: eyeLookInRight
          weight: 25
      strength: {x: 0.6, y: 1}
    - name: Character right
      pose:
        targets:
        - shape: eyeLookInLeft
          weight: 25
        - shape: eyeLookOutRight
          weight: 25
      strength: {x: 0.6, y: 1}
    - name: Up
      pose:
        targets:
        - shape: eyeLookUpLeft
          weight: 25
        - shape: eyeLookUpRight
          weight: 25
      strength: {x: 0.6, y: 1}
    - name: Down
      pose:
        targets:
        - shape: eyeLookDownLeft
          weight: 25
        - shape: eyeLookDownRight
          weight: 25
      strength: {x: 0.6, y: 1}
    repeat:
      probability: 0
      maximumAdditionalRepetitions: 1
      gap: {x: 0.12, y: 0.25}
  previewDefinition: {fileID: 11400000, guid: e9a1d8a34839d34408cbce213e3f2ec7, type: 2}
