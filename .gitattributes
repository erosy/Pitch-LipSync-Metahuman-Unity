# Unity text assets: force LF, merge with Unity's YAML merge tool
*.unity   text eol=lf merge=unityyamlmerge
*.prefab  text eol=lf merge=unityyamlmerge
*.asset   text eol=lf merge=unityyamlmerge
*.mat     text eol=lf merge=unityyamlmerge
*.anim filter=lfs diff=lfs merge=lfs -text
*.controller text eol=lf merge=unityyamlmerge
*.meta    text eol=lf
*.cs      text eol=lf diff=csharp
# Demo Team Hair uses PreferBinarySerialization; text normalization corrupts it.
"Assets/_Sandbox/Groom Hair Asset/SC_Hairstyle_Male_11.asset" binary
"Assets/_Sandbox/Groom Hair Asset/Fitted/Ethan_BlenderFitted.asset" binary
"Assets/_Sandbox/Groom Hair Asset/Fitted/Ethan_EarClearance.asset" binary
